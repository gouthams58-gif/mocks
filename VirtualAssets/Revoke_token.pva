        value:
          fixedValue:
            $type: StringTestValue
      wsaKeys:
      - name: MessageID
        value:
          values:
          - $type: MessageIDTestValue
          fixedValue:
            $type: StringTestValue
      preRequestHeader:
        $type: NamedToolOutputProvider
        menuName: Transport Header
        name: Pre-correlation Incoming Transport Header
      xmlPreRequestOutput:
        $type: NamedXMLToolOutputProvider
        outputTools:
        - $type: MethodTool
          dataSourceNames:
          - Revoke_token_Datasource
          enabled: false
          iconName: Method
          name: Extension Tool 2
          method:
            hasCode: true
            code:
              $type: ScriptCode
              input:
                useText: true
                textInput:
                  $type: ScriptingTextInput
                  text: "import com.parasoft.api.*\r\nimport javax.crypto.Cipher\r\
                    \nimport java.security.*\r\nimport java.security.spec.*\r\nimport\
                    \ java.nio.charset.StandardCharsets\r\nimport java.util.Base64\r\
                    \nimport java.nio.file.Files\r\nimport java.nio.file.Paths\r\n\
                    \r\ndef loadPrivateKey(String filename) {\r\n    String key =\
                    \ new String(Files.readAllBytes(Paths.get(filename)), StandardCharsets.UTF_8)\r\
                    \n    key = key.replaceAll(\"-----BEGIN (.*)-----\", \"\")\r\n\
                    \             .replaceAll(\"-----END (.*)-----\", \"\")\r\n  \
                    \           .replaceAll(\"\\\\s\", \"\")\r\n    byte[] decoded\
                    \ = Base64.decoder.decode(key)\r\n    PKCS8EncodedKeySpec spec\
                    \ = new PKCS8EncodedKeySpec(decoded)\r\n    KeyFactory kf = KeyFactory.getInstance(\"\
                    RSA\")\r\n    return kf.generatePrivate(spec)\r\n}\r\n\r\ndef\
                    \ decryptRequest(Object input, ExtensionToolContext context) {\r\
                    \n    String encryptedRequest = input.toString().trim()\r\n  \
                    \  if (encryptedRequest.startsWith(\"\\\"\") && encryptedRequest.endsWith(\"\
                    \\\"\")) {\r\n        encryptedRequest = encryptedRequest.substring(1,\
                    \ encryptedRequest.length() - 1)\r\n    }\r\n    encryptedRequest\
                    \ = encryptedRequest.replaceAll(\"\\\\s+\", \"\")\r\n    Application.showMessage(\"\
                    Received Encrypted Request: \" + encryptedRequest)\r\n\r\n   \
                    \ // Load RSA private key from PEM\r\n    //PrivateKey privateKey\
                    \ = loadPrivateKey(\"C:\\\\Program Files\\\\Git\\\\usr\\\\bin\\\
                    \\private_key.pem\")\r\n    PrivateKey privateKey = loadPrivateKey(\"\
                    C:\\\\Users\\\\brajagopal\\\\Desktop\\\\ICICI\\\\private_4096.key\"\
                    )\r\n    \r\n\tApplication.showMessage(\"Line 31\")\r\n    //\
                    \ Decode Base64 input\r\n    byte[] cipherBytes = Base64.decoder.decode(encryptedRequest)\r\
                    \n\tApplication.showMessage(\"Line 34\")\r\n    // Decrypt with\
                    \ RSA/ECB/PKCS1Padding\r\n    Cipher cipher = Cipher.getInstance(\"\
                    RSA/ECB/PKCS1Padding\")\r\n    Application.showMessage(\"Line\
                    \ 37\")\r\n    cipher.init(Cipher.DECRYPT_MODE, privateKey)\r\n\
                    \    Application.showMessage(\"Line 39\")\r\n    byte[] plainBytes\
                    \ = cipher.doFinal(cipherBytes)\r\n    Application.showMessage(\"\
                    Line 41\")\r\n\r\n    String decryptedJson = new String(plainBytes,\
                    \ StandardCharsets.UTF_8)\r\n    Application.showMessage(\"Line\
                    \ 44\")\r\n    Application.showMessage(\"Decrypted JSON: \" +\
                    \ decryptedJson)\r\n\r\n    return decryptedJson\r\n}\r\n"
            hasMethodId: true
            methodId:
              $type: ScriptMethodIdentifier
              functionName: decryptRequest
              arguments:
              - java.lang.Object
              - com.parasoft.api.ExtensionToolContext
        - $type: MethodTool
          dataSourceNames:
          - Revoke_token_Datasource
          iconName: Method
          name: Extension Tool
          method:
            hasCode: true
            code:
              $type: ScriptCode
              input:
                useText: true
                textInput:
                  $type: ScriptingTextInput
                  text: "import com.parasoft.api.*\r\nimport javax.crypto.Cipher\r\
                    \nimport java.security.*\r\nimport java.security.spec.*\r\nimport\
                    \ java.security.interfaces.RSAPrivateKey\r\nimport java.nio.charset.StandardCharsets\r\
                    \nimport java.util.Base64\r\nimport java.nio.file.Files\r\nimport\
                    \ java.nio.file.Paths\r\nimport java.io.ByteArrayOutputStream\r\
                    \nimport java.util.Arrays\r\n\r\n// Utility to load RSA private\
                    \ key from PEM\r\ndef loadPrivateKey(String filename) {\r\n  \
                    \  String key = new String(Files.readAllBytes(Paths.get(filename)),\
                    \ StandardCharsets.UTF_8)\r\n    key = key.replaceAll(\"-----BEGIN\
                    \ (.*)-----\", \"\")\r\n             .replaceAll(\"-----END (.*)-----\"\
                    , \"\")\r\n             .replaceAll(\"\\\\s\", \"\")\r\n    byte[]\
                    \ decoded = Base64.decoder.decode(key)\r\n    PKCS8EncodedKeySpec\
                    \ spec = new PKCS8EncodedKeySpec(decoded)\r\n    KeyFactory kf\
                    \ = KeyFactory.getInstance(\"RSA\")\r\n    return kf.generatePrivate(spec)\r\
                    \n}\r\n\r\n// Utility to decrypt large RSA data by chunking\r\n\
                    def rsaDecryptLargeData(byte[] cipherBytes, PrivateKey privateKey)\
                    \ {\r\n    Cipher cipher = Cipher.getInstance(\"RSA/ECB/PKCS1Padding\"\
                    )\r\n    cipher.init(Cipher.DECRYPT_MODE, privateKey)\r\n\r\n\
                    \    int keySizeBytes = ((RSAPrivateKey) privateKey).getModulus().bitLength()\
                    \ / 8\r\n    ByteArrayOutputStream outputStream = new ByteArrayOutputStream()\r\
                    \n\r\n    for (int i = 0; i < cipherBytes.length; i += keySizeBytes)\
                    \ {\r\n        int len = Math.min(keySizeBytes, cipherBytes.length\
                    \ - i)\r\n        byte[] chunk = Arrays.copyOfRange(cipherBytes,\
                    \ i, i + len)\r\n        outputStream.write(cipher.doFinal(chunk))\r\
                    \n    }\r\n    return outputStream.toByteArray()\r\n}\r\n\r\n\
                    def decryptRequest(Object input, ExtensionToolContext context)\
                    \ {\r\n    String encryptedRequest = input.toString().trim()\r\
                    \n    if (encryptedRequest.startsWith(\"\\\"\") && encryptedRequest.endsWith(\"\
                    \\\"\")) {\r\n        encryptedRequest = encryptedRequest.substring(1,\
                    \ encryptedRequest.length() - 1)\r\n    }\r\n    encryptedRequest\
                    \ = encryptedRequest.replaceAll(\"\\\\s+\", \"\")\r\n    Application.showMessage(\"\
                    Received Encrypted Request: \" + encryptedRequest)\r\n\r\n   \
                    \ // Load RSA private key from PEM\r\n    PrivateKey privateKey\
                    \ = loadPrivateKey(\"C:\\\\Users\\\\greddy\\\\Downloads\\\\private_4096.key\"\
                    )\r\n\r\n    // Decode Base64 input\r\n    byte[] cipherBytes\
                    \ = Base64.decoder.decode(encryptedRequest)\r\n\r\n    // Decrypt\
                    \ with RSA using chunking\r\n    byte[] plainBytes = rsaDecryptLargeData(cipherBytes,\
                    \ privateKey)\r\n\r\n    String decryptedJson = new String(plainBytes,\
                    \ StandardCharsets.UTF_8)\r\n    Application.showMessage(\"Decrypted\
                    \ JSON: \" + decryptedJson)\r\n\r\n    return decryptedJson\r\n\
                    }\r\n"
            hasMethodId: true
            methodId:
              $type: ScriptMethodIdentifier
              functionName: decryptRequest
              arguments:
              - java.lang.Object
              - com.parasoft.api.ExtensionToolContext
            useDataSource: true
        menuName: Payload
