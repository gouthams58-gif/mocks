          dataSourceNames:
          - Revoke_token_Datasource
          enabled: false
          iconName: Method
          name: Extension Tool
          outputProvider:
            outputTools:
            - $type: GenericDataBank
              dataSourceNames:
              - Revoke_token_Datasource
              enabled: false
              iconName: XMLDataBank
              name: JSON Data Bank
              wrappedTool:
                $type: XMLtoDataSource
                dataSourceNames:
                - Revoke_token_Datasource
                iconName: XMLDataBank
                name: XML Data Bank
                selectedXPaths:
                - elementOption: 1
                  contentOption: 1
                  XMLDataBank_ExtractXPath: /root/text()
                  mode: 1
                canonicalizeOutput: true
                xmlMessage: true
                virtualDSCreator:
                  writableColumns:
                  - customName: root
              conversionStrategy:
                dataFormatName: JSON
                conversionStrategyId: JSON
                conversionStrategyClassName: com.parasoft.xml.convert.json.JsonConversionStrategy
          method:
            hasCode: true
            code:
              $type: ScriptCode
              input:
                useText: true
                textInput:
                  $type: ScriptingTextInput
                  text: "import com.parasoft.api.*\nimport javax.crypto.Cipher\nimport\
                    \ java.security.*\nimport java.security.spec.*\nimport java.nio.charset.StandardCharsets\n\
                    import java.util.Base64\nimport java.nio.file.Files\nimport java.nio.file.Paths\n\
                    \n// Utility to load RSA public key from PEM\ndef loadPublicKey(String\
                    \ filename) {\n    String key = new String(Files.readAllBytes(Paths.get(filename)),\
                    \ StandardCharsets.UTF_8)\n    key = key.replaceAll(\"-----BEGIN\
                    \ (.*)-----\", \"\")\n             .replaceAll(\"-----END (.*)-----\"\
                    , \"\")\n             .replaceAll(\"\\\\s\", \"\")\n    byte[]\
                    \ decoded = Base64.decoder.decode(key)\n    X509EncodedKeySpec\
                    \ spec = new X509EncodedKeySpec(decoded)\n    KeyFactory kf =\
                    \ KeyFactory.getInstance(\"RSA\")\n    return kf.generatePublic(spec)\n\
                    }\n\ndef encryptRequest(Object input, ExtensionToolContext context)\
                    \ {\n    // Read values from Data Source\n    def status = context.getValue(\"\
                    Revoke_token_Datasource\",\"status\")\n    //Application.showMessage(VAN)\n\
                    \tdef Message = context.getValue(\"Revoke_token_Datasource\",\"\
                    Message\")\n\t\n    // Build JSON payload\n    def plainText =\
                    \ \"{ \\\"status\\\": \\\"${status}\\\", \\\"Message\\\": \\\"\
                    ${Message}\\\"}\"\n    Application.showMessage(\"Plain JSON: \"\
                    \ + plainText)\n\n    // Load RSA public key from PEM\n    //def\
                    \ publicKeyPath = \"C:\\\\Program Files\\\\Git\\\\usr\\\\bin\\\
                    \\public_key.pem\"\n    def publicKeyPath = \"C:\\\\Users\\\\\
                    brajagopal\\\\Desktop\\\\ICICI\\\\public_4096.pem\"\n    PublicKey\
                    \ publicKey = loadPublicKey(publicKeyPath)\n\n    // Encrypt with\
                    \ RSA/ECB/PKCS1Padding\n    Cipher cipher = Cipher.getInstance(\"\
                    RSA/ECB/PKCS1Padding\")\n    cipher.init(Cipher.ENCRYPT_MODE,\
                    \ publicKey)\n    byte[] cipherBytes = cipher.doFinal(plainText.getBytes(StandardCharsets.UTF_8))\n\
                    \n    // Encode to Base64\n    String encryptedPayload = Base64.encoder.encodeToString(cipherBytes)\n\
                    \    Application.showMessage(\"Encrypted request: \" + encryptedPayload)\n\
                    \n    // Replace request body with encrypted payload (quoted for\
                    \ JSON)\n    context.setValue(\"response\", \"\\\"${encryptedPayload}\\\
                    \"\")\n    return \"\\\"${encryptedPayload}\\\"\"\n}\n"
            hasMethodId: true
            methodId:
              $type: ScriptMethodIdentifier
              functionName: encryptRequest
              arguments:
              - java.lang.Object
              - com.parasoft.api.ExtensionToolContext
            useDataSource: true
        - $type: MethodTool
          dataSourceNames:
          - Revoke_token_Datasource
          iconName: Method
          name: Extension Tool 2
          outputProvider:
            outputTools:
            - $type: GenericDataBank
              dataSourceNames:
              - Revoke_token_Datasource
              iconName: XMLDataBank
              name: JSON Data Bank
              wrappedTool:
                $type: XMLtoDataSource
                dataSourceNames:
                - Revoke_token_Datasource
                iconName: XMLDataBank
                name: XML Data Bank
                selectedXPaths:
                - elementOption: 1
                  contentOption: 1
                  XMLDataBank_ExtractXPath: /root/text()
                  mode: 1
                canonicalizeOutput: true
                xmlMessage: true
                virtualDSCreator:
                  writableColumns:
                  - customName: root
              conversionStrategy:
                dataFormatName: JSON
                conversionStrategyId: JSON
                conversionStrategyClassName: com.parasoft.xml.convert.json.JsonConversionStrategy
          method:
            hasCode: true
            code:
              $type: ScriptCode
              input:
                useText: true
                textInput:
                  $type: ScriptingTextInput
                  text: "import com.parasoft.api.*\r\nimport javax.crypto.Cipher\r\
                    \nimport java.security.*\r\nimport java.security.spec.*\r\nimport\
                    \ java.security.interfaces.RSAPublicKey\r\nimport java.nio.charset.StandardCharsets\r\
                    \nimport java.util.Base64\r\nimport java.nio.file.Files\r\nimport\
                    \ java.nio.file.Paths\r\nimport java.io.ByteArrayOutputStream\r\
                    \nimport java.util.Arrays\r\n\r\n// Utility to load RSA public\
                    \ key from PEM\r\ndef loadPublicKey(String filename) {\r\n   \
                    \ String key = new String(Files.readAllBytes(Paths.get(filename)),\
                    \ StandardCharsets.UTF_8)\r\n    key = key.replaceAll(\"-----BEGIN\
                    \ (.*)-----\", \"\")\r\n             .replaceAll(\"-----END (.*)-----\"\
                    , \"\")\r\n             .replaceAll(\"\\\\s\", \"\")\r\n    byte[]\
                    \ decoded = Base64.decoder.decode(key)\r\n    X509EncodedKeySpec\
                    \ spec = new X509EncodedKeySpec(decoded)\r\n    KeyFactory kf\
                    \ = KeyFactory.getInstance(\"RSA\")\r\n    return kf.generatePublic(spec)\r\
                    \n}\r\n\r\n// Utility to encrypt large data with RSA by chunking\r\
                    \ndef rsaEncryptLargeData(String data, PublicKey publicKey) {\r\
                    \n    Cipher cipher = Cipher.getInstance(\"RSA/ECB/PKCS1Padding\"\
                    )\r\n    cipher.init(Cipher.ENCRYPT_MODE, publicKey)\r\n\r\n \
                    \   byte[] inputBytes = data.getBytes(StandardCharsets.UTF_8)\r\
                    \n    int keySizeBytes = ((RSAPublicKey) publicKey).getModulus().bitLength()\
                    \ / 8\r\n    int blockSize = keySizeBytes - 11  // account for\
                    \ PKCS1 padding\r\n\r\n    ByteArrayOutputStream outputStream\
                    \ = new ByteArrayOutputStream()\r\n\r\n    for (int i = 0; i <\
                    \ inputBytes.length; i += blockSize) {\r\n        int len = Math.min(blockSize,\
                    \ inputBytes.length - i)\r\n        byte[] chunk = Arrays.copyOfRange(inputBytes,\
                    \ i, i + len)\r\n        outputStream.write(cipher.doFinal(chunk))\r\
                    \n    }\r\n    return Base64.encoder.encodeToString(outputStream.toByteArray())\r\
                    \n}\r\n\r\ndef encryptResponse(Object input, ExtensionToolContext\
                    \ context) {\r\n    // Read values from Data Source\r\n    def\
                    \ status = context.getValue(\"Revoke_token_Datasource\",\"status\"\
                    )\r\n    def Message = context.getValue(\"Revoke_token_Datasource\"\
                    ,\"Message\")\r\n\r\n    // Build JSON payload\r\n    def plainText\
                    \ = \"{ \\\"status\\\": \\\"${status}\\\", \\\"Message\\\": \\\
                    \"${Message}\\\"}\"\r\n    Application.showMessage(\"Plain JSON:\
                    \ \" + plainText)\r\n\r\n    // Load RSA public key from PEM\r\
                    \n    def publicKeyPath = \"C:\\\\Users\\\\greddy\\\\Downloads\\\
                    \\public_4096.pem\"\r\n    PublicKey publicKey = loadPublicKey(publicKeyPath)\r\
                    \n\r\n    // Encrypt with RSA using chunking\r\n    String encryptedPayload\
                    \ = rsaEncryptLargeData(plainText, publicKey)\r\n    Application.showMessage(\"\
                    Encrypted request: \" + encryptedPayload)\r\n\r\n    // Replace\
                    \ response body with encrypted payload (quoted for JSON)\r\n \
                    \   context.setValue(\"response\", \"\\\"${encryptedPayload}\\\
                    \"\")\r\n    return \"\\\"${encryptedPayload}\\\"\"\r\n}\r\n"
            hasMethodId: true
            methodId:
              $type: ScriptMethodIdentifier
              functionName: encryptResponse
              arguments:
              - java.lang.Object
              - com.parasoft.api.ExtensionToolContext
            useDataSource: true
