                                    \ respond(ScriptingContext context) {\r\n    //\
                                    \ Get ID and Payload from request\r\n    String\
                                    \ id = context.getValue(\"CAN Datasource\",\"\
                                    ID\")\r\n    String payloadStr = context.getValue(\"\
                                    CAN Datasource\",\"Payload\")\r\n\r\n    // Split\
                                    \ payload into bytes\r\n    def bytes = []\r\n\
                                    \    if (payloadStr != null) {\r\n        payloadStr.split(\"\
                                    \ \").each { b ->\r\n            try {\r\n   \
                                    \             bytes << Integer.parseInt(b, 16)\r\
                                    \n            } catch (Exception e) {\r\n    \
                                    \            // ignore parse errors\r\n      \
                                    \      }\r\n        }\r\n    }\r\n\r\n    // Interpret\
                                    \ first byte\r\n    String meaning = \"Unknown\"\
                                    \r\n    if (!bytes.isEmpty()) {\r\n        switch\
                                    \ (bytes[0]) {\r\n            case 0x00: meaning\
                                    \ = \"Airbag not deployed\"; break\r\n       \
                                    \     case 0x01: meaning = \"Airbag deployed\"\
                                    ; break\r\n            case 0x02: meaning = \"\
                                    Airbag armed\"; break\r\n            case 0xFF:\
                                    \ meaning = \"Fault detected\"; break\r\n    \
                                    \        default:   meaning = \"Unknown\"; break\r\
                                    \n        }\r\n    }\r\n\r\n    // Build JSON\
                                    \ response\r\n    String timestamp = java.time.Instant.now().toString()\r\
                                    \n    def responseMap = [\r\n        \"Timestamp\"\
                                    : timestamp,\r\n        \"ID\"       : id,\r\n\
                                    \        \"Payload\"  : payloadStr,\r\n      \
                                    \  \"message\"  : meaning\r\n    ]\r\n\r\n   \
                                    \ // Return JSON string\r\n    return new groovy.json.JsonBuilder(responseMap).toString()\r\
                                    \n}\r\n"
                            hasMethodId: true
